{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported cross-witness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["witness_id", "kind", "context_hash", "source_ids", "claims"],
  "properties": {
    "witness_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["fixture", "imported"] },
    "context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "interpretations",
        "recommendations",
        "user_approvals",
        "actions_taken",
        "uncertainties"
      ],
      "properties": {
        "evidence": { "$ref": "#/$defs/claim_list" },
        "interpretations": { "$ref": "#/$defs/claim_list" },
        "recommendations": { "$ref": "#/$defs/claim_list" },
        "user_approvals": { "$ref": "#/$defs/claim_list" },
        "actions_taken": { "$ref": "#/$defs/claim_list" },
        "uncertainties": { "$ref": "#/$defs/claim_list" }
      }
    }
  },
  "$defs": {
    "claim_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_ids"],
        "properties": {
          "text": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
