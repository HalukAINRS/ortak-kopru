{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ortak Köprü governed policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "visibility",
    "sources",
    "permissions",
    "allowed_providers",
    "allowed_tools",
    "approval_required",
    "limits",
    "prompt"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "accepted_unknown_layers"],
      "properties": {
        "mode": { "enum": ["strict", "limited"] },
        "accepted_unknown_layers": {
          "type": "array",
          "items": {
            "enum": [
              "provider_system_and_safety",
              "server_routing_and_telemetry",
              "model_training"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "transmit"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["application_instruction", "untrusted_evidence"] },
          "transmit": { "type": "boolean" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "write"],
      "properties": {
        "network": { "type": "boolean" },
        "write": { "const": false }
      }
    },
    "allowed_providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model"],
        "properties": {
          "provider": { "enum": ["anthropic", "openai", "google"] },
          "model": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowed_tools": { "type": "array", "maxItems": 0 },
    "approval_required": {
      "type": "array",
      "const": ["provider_call"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "max_calls", "timeout_seconds", "max_output_tokens"],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_calls": { "type": "integer", "const": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": { "system": { "type": "string", "minLength": 1 } }
    }
  }
}
