{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halukainrs.github.io/ortak-kopru/policy/policy.schema.json",
  "title": "Ortak Köprü policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "sources",
    "provider",
    "permissions",
    "limits",
    "approvals_required",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "application_instruction",
              "user_task",
              "untrusted_evidence",
              "configuration"
            ]
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "model_requested",
        "reasoning_requested",
        "allowed_providers",
        "allowed_models",
        "allowed_reasoning",
        "allowed_fallbacks"
      ],
      "properties": {
        "requested": {
          "type": "string"
        },
        "model_requested": {
          "type": "string"
        },
        "reasoning_requested": {
          "type": "string"
        },
        "allowed_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_provider_call",
        "allow_network",
        "allow_write",
        "tools"
      ],
      "properties": {
        "allow_provider_call": {
          "type": "boolean"
        },
        "allow_network": {
          "type": "boolean"
        },
        "allow_write": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_rounds",
        "timeout_seconds",
        "max_output_bytes",
        "max_output_tokens",
        "approval_max_minutes"
      ],
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "approval_max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      }
    },
    "approvals_required": {
      "type": "array",
      "items": {
        "enum": [
          "provider_call",
          "network",
          "write"
        ]
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "strict",
        "accepted_unknown"
      ],
      "properties": {
        "visibility": {
          "enum": [
            "known",
            "unknown",
            "partial"
          ]
        },
        "strict": {
          "type": "boolean"
        },
        "accepted_unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "provider_system_prompt",
              "provider_training",
              "server_side_routing",
              "provider_telemetry"
            ]
          }
        }
      }
    }
  }
}
