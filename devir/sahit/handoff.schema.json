{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Şahit CLI devir paketi (source.json / handoff.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_version", "prepared_on", "supersedes", "title", "prepared_state", "acceptance",
    "source_snapshot_commit", "main_snapshot_commit", "scope", "completeness_matrix", "missing_sources",
    "verified_repository", "local_verification", "user_requests", "conversation_excerpt", "decisions",
    "access_map", "open_items", "known_risks", "startup_prompt"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "bundle_version": { "type": "string", "minLength": 1 },
    "prepared_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "supersedes": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "prepared_state": { "type": "string", "pattern": "^hazır/bekliyor" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accepted", "how", "scope_of_acceptance"],
      "properties": {
        "state": { "const": "hazır/bekliyor" },
        "accepted": { "const": false },
        "how": { "type": "string", "minLength": 1 },
        "scope_of_acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "source_snapshot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "main_snapshot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "included", "excluded", "truncation", "privacy_boundary"],
      "properties": {
        "completeness": { "type": "string", "minLength": 1 },
        "included": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "excluded": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "truncation": { "type": "string" },
        "privacy_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "completeness_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "level", "basis", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "area": { "type": "string", "minLength": 1 },
          "level": { "enum": ["kesin", "kısmi", "eksik"] },
          "basis": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "missing_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "state", "reason", "who_can_supply"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source": { "type": "string", "minLength": 1 },
          "state": { "enum": ["eksik", "doğrulanamadı", "erişilemez"] },
          "reason": { "type": "string", "minLength": 1 },
          "who_can_supply": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verified_repository": {
      "type": "object",
      "required": [
        "repository", "base_branch", "base_commit", "working_branch", "merged_from", "pinned_repository_files",
        "observed_repository_files", "files_read_fully", "files_read_partially", "prior_pull_requests",
        "other_branches", "previous_task_references", "repository_invariants"
      ],
      "properties": {
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pinned_repository_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "observed_repository_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "prior_pull_requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["number", "state", "purpose"],
            "properties": {
              "number": { "type": "integer", "minimum": 1 },
              "state": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        },
        "previous_task_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "state", "note"],
            "properties": { "state": { "const": "unverified" } }
          }
        }
      }
    },
    "local_verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "result", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "check": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "status": { "enum": ["observed", "not_run"] }
        }
      }
    },
    "user_requests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["kind", "text"], "properties": { "kind": { "const": "direct_user_request" } } }
    },
    "conversation_excerpt": {
      "type": "array",
      "items": { "type": "object", "required": ["speaker", "classification", "text"] }
    },
    "decisions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "access_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "source_path", "version", "hash", "observation_method", "access", "evidence_status", "purpose", "write_permission"]
      }
    },
    "open_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "owner", "state", "item", "evidence_required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "priority": { "type": "integer", "minimum": 1 },
          "owner": { "enum": ["user", "sahit", "user+sahit"] },
          "state": { "enum": ["planned", "partial", "unverified", "blocked"] },
          "item": { "type": "string", "minLength": 1 },
          "evidence_required": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "risk", "evidence", "mitigation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "severity": { "enum": ["low", "medium", "high"] },
          "risk": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "mitigation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "startup_prompt": { "type": "string", "minLength": 1 }
  }
}
