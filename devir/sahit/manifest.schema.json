{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Şahit CLI devir manifesti (manifest.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_version", "prepared_on", "source_file", "source_sha256", "source_snapshot_commit",
    "main_snapshot_commit", "outputs_sha256", "pinned_sources_sha256", "observed_sources_sha256", "bundle_sha256",
    "manifest_self_hash", "line_endings", "privacy_boundary", "scan_limit"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "bundle_version": { "type": "string", "minLength": 1 },
    "prepared_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_file": { "const": "source.json" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_snapshot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "main_snapshot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "outputs_sha256": { "type": "object", "required": ["handoff.txt", "handoff.html", "handoff.json", "START_HERE.md"] },
    "pinned_sources_sha256": { "type": "object" },
    "observed_sources_sha256": { "type": "object" },
    "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_self_hash": { "type": "string" },
    "line_endings": { "type": "string" },
    "privacy_boundary": { "type": "string", "minLength": 1 },
    "scan_limit": { "type": "string", "minLength": 1 }
  }
}
