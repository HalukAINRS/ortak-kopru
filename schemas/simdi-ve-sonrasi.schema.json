{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rafinasyonun dokuz sorusu v1: şimdi ve sonrası",
  "description": "Bir rafine çalışmasını Ne, Nerede, Ne zaman, Ne kadar, Nereden, Neden, Nasıl, Ne için ve Nereye sorularıyla iki zamanda ele alır. 'simdi' rafinenin gözlenen hâlidir; 'sonra' rafine sonrası olabilecek senaryolardır ve hiçbiri gerçekleşmiş sayılmaz. Sorular varyantlarıyla (Ne zaman bozulur?, Nasıl geri alınır? gibi) ve birbirleriyle birleşerek (Nereden → Nereye gibi) sorulur. 'hesaplanan' alanını tools/rafine_sorulari.py depodan üretir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "konu", "hazirlayan", "hazirlandi", "kesit", "sorular", "simdi", "sonra", "birlesimler", "hesaplanan"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ortak_kopru_simdi_ve_sonrasi"},
    "konu": {"type": "string", "minLength": 1},
    "hazirlayan": {"type": "string", "minLength": 1, "maxLength": 200},
    "hazirlandi": {"type": "string", "format": "date-time"},
    "kesit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dal", "pr", "temel_commit"],
      "properties": {
        "dal": {"type": "string", "minLength": 1},
        "pr": {"type": "integer", "minimum": 1},
        "temel_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Rafinenin üzerine kurulduğu ana dal ucu."}
      }
    },
    "sorular": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kok", "soru", "varyantlar"],
        "properties": {
          "kok": {"$ref": "#/$defs/kok"},
          "soru": {"type": "string", "minLength": 1},
          "varyantlar": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "soru", "anlam"],
              "properties": {
                "id": {"$ref": "#/$defs/varyant_id"},
                "soru": {"type": "string", "minLength": 1},
                "anlam": {"type": "string", "minLength": 1, "description": "Varyantın kök sorudan farklı olarak neyi aradığı."}
              }
            }
          }
        }
      }
    },
    "simdi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ne", "nerede", "ne_zaman", "ne_kadar", "nereden", "neden", "nasil", "ne_icin", "nereye"],
      "properties": {
        "ne": {"$ref": "#/$defs/simdi_yaniti"},
        "nerede": {"$ref": "#/$defs/simdi_yaniti"},
        "ne_zaman": {"$ref": "#/$defs/simdi_yaniti"},
        "ne_kadar": {"$ref": "#/$defs/simdi_yaniti"},
        "nereden": {"$ref": "#/$defs/simdi_yaniti"},
        "neden": {"$ref": "#/$defs/simdi_yaniti"},
        "nasil": {"$ref": "#/$defs/simdi_yaniti"},
        "ne_icin": {"$ref": "#/$defs/simdi_yaniti"},
        "nereye": {"$ref": "#/$defs/simdi_yaniti"}
      }
    },
    "sonra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["senaryolar"],
      "properties": {
        "senaryolar": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/senaryo"}}
      }
    },
    "birlesimler": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/birlesim"}},
    "hesaplanan": {
      "type": "object",
      "description": "tools/simdi_ve_sonrasi.py'nin depodan hesapladığı değerler; defter ve günlüklere bağlı olanlar tarihli gözlemdir.",
      "additionalProperties": {"oneOf": [{"type": "integer"}, {"type": "string", "minLength": 1}]}
    }
  },
  "$defs": {
    "kok": {"enum": ["ne", "nerede", "ne_zaman", "ne_kadar", "nereden", "neden", "nasil", "ne_icin", "nereye"]},
    "varyant_id": {"type": "string", "pattern": "^(ne|nerede|ne_zaman|ne_kadar|nereden|neden|nasil|ne_icin|nereye)\\.[a-z_]+$"},
    "durum": {"enum": ["gözlendi", "beyan", "yorum", "açık"]},
    "simdi_yaniti": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yanit", "ogeler"],
      "properties": {
        "yanit": {"type": "string", "minLength": 1},
        "ogeler": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/oge"}}
      }
    },
    "oge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ad", "aciklama", "durum"],
      "properties": {
        "ad": {"type": "string", "minLength": 1},
        "aciklama": {"type": "string", "minLength": 1},
        "durum": {"$ref": "#/$defs/durum"},
        "varyant": {"$ref": "#/$defs/varyant_id"},
        "dayanak": {"type": "string", "minLength": 1, "description": "Depo içi yol (isteğe bağlı #çapa veya :satır) ya da https adresi; depo içi yollar denetlenir."},
        "olcum": {"type": "string", "minLength": 1, "description": "depo_tanimi veya simdi_ve_sonrasi ölçüm anahtarı; denetlenir."}
      }
    },
    "senaryo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ad", "durum", "karar", "kaynak_bulgu", "onkosul", "yanitlar", "varyantlar"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "ad": {"type": "string", "minLength": 1},
        "durum": {"enum": ["öneri", "olasılık", "beyan"], "description": "Hiçbiri gerçekleşmiş değildir; öneri bu çalışmanın önerisidir, olasılık açık seçenek, beyan depo belgelerinin söylediği yön."},
        "karar": {"type": "string", "minLength": 1, "description": "Senaryoyu kimin veya hangi gözlemin başlatacağı."},
        "kaynak_bulgu": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{2}$"}},
        "onkosul": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
        "yanitlar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ne", "nerede", "ne_zaman", "ne_kadar", "nereden", "neden", "nasil", "ne_icin", "nereye"],
          "properties": {
            "ne": {"type": "string", "minLength": 1},
            "nerede": {"type": "string", "minLength": 1},
            "ne_zaman": {"type": "string", "minLength": 1},
            "ne_kadar": {"type": "string", "minLength": 1},
            "nereden": {"type": "string", "minLength": 1},
            "neden": {"type": "string", "minLength": 1},
            "nasil": {"type": "string", "minLength": 1},
            "ne_icin": {"type": "string", "minLength": 1},
            "nereye": {"type": "string", "minLength": 1}
          }
        },
        "varyantlar": {
          "type": "object",
          "description": "Varyant kimliği → yanıt. Her senaryo en az 'nasil.geri_alinir' varyantını yanıtlar.",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "olcumler": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "birlesim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sorular", "soru", "katman", "yanit", "durum"],
      "properties": {
        "id": {"type": "string", "pattern": "^B[0-9]{2}$"},
        "sorular": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/kok"}},
        "varyantlar": {"type": "array", "items": {"$ref": "#/$defs/varyant_id"}},
        "soru": {"type": "string", "minLength": 1},
        "katman": {"enum": ["simdi", "sonra", "ikisi"]},
        "yanit": {"type": "string", "minLength": 1},
        "durum": {"$ref": "#/$defs/durum"},
        "dayanak": {"type": "string", "minLength": 1},
        "olcumler": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
