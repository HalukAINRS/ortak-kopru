{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEUS result-bound verification receipt v1",
  "description": "Caller declares observed checks. Core requires current result ID and all task criteria before completion; the declaration is not an independent test execution.",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "required": [
      "criterion_id",
      "result_id",
      "passed",
      "evidence",
      "verifier"
    ],
    "properties": {
      "criterion_id": {
        "type": "string",
        "minLength": 1
      },
      "result_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "passed": {
        "type": "boolean"
      },
      "evidence": {
        "type": "string",
        "minLength": 1
      },
      "verifier": {
        "type": "string",
        "minLength": 1
      },
      "task_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "at": {
        "type": "string",
        "minLength": 1
      },
      "verification": {
        "const": "submitted_receipt"
      }
    },
    "additionalProperties": false
  }
}
