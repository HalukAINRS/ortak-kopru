{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ortak Köprü dokuz koordinatlı depo tanımı v1",
  "description": "Depoyu Ne, Nerede, Ne zaman, Ne kadar, Nereden, Neden, Nasıl, Ne için ve Nereye sorularıyla tanımlar. Her öğe kendi bilgi statüsünü taşır: gözlendi (bu tanımı hazırlayan oturumda ölçüldü veya okundu), beyan (depo belgelerinin söylediği, ayrıca gözlenmedi), yorum (hazırlayanın kurduğu ilişki), açık (karar veya gözlem bekliyor). ne_kadar.olcumler alanını tools/depo_tanimi.py depodan ölçer ve --check ile denetler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tanimlanan", "hazirlayan", "hazirlandi", "koordinatlar"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ortak_kopru_depo_tanimi"},
    "tanimlanan": {"type": "string", "minLength": 1, "description": "Tanımın ait olduğu dal veya commit."},
    "hazirlayan": {"type": "string", "minLength": 1, "maxLength": 200},
    "hazirlandi": {"type": "string", "format": "date-time"},
    "koordinatlar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ne", "nerede", "ne_zaman", "ne_kadar", "nereden", "neden", "nasil", "ne_icin", "nereye"],
      "properties": {
        "ne": {"$ref": "#/$defs/koordinat"},
        "nerede": {"$ref": "#/$defs/koordinat"},
        "ne_zaman": {"$ref": "#/$defs/koordinat"},
        "ne_kadar": {"$ref": "#/$defs/koordinat"},
        "nereden": {"$ref": "#/$defs/koordinat"},
        "neden": {"$ref": "#/$defs/koordinat"},
        "nasil": {"$ref": "#/$defs/koordinat"},
        "ne_icin": {"$ref": "#/$defs/koordinat"},
        "nereye": {"$ref": "#/$defs/koordinat"}
      }
    }
  },
  "$defs": {
    "koordinat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soru", "yanit", "ogeler"],
      "properties": {
        "soru": {"type": "string", "minLength": 1},
        "yanit": {"type": "string", "minLength": 1, "description": "Koordinatın tek cümlelik yanıtı."},
        "ogeler": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/oge"}},
        "olcumler": {
          "type": "object",
          "description": "Yalnız ne_kadar: araçla ölçülen ve denetlenen değerler.",
          "additionalProperties": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]}
        }
      }
    },
    "oge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ad", "aciklama", "durum"],
      "properties": {
        "ad": {"type": "string", "minLength": 1},
        "aciklama": {"type": "string", "minLength": 1},
        "durum": {"enum": ["gözlendi", "beyan", "yorum", "açık"]},
        "dayanak": {"type": "string", "minLength": 1, "description": "Depo içi yol (isteğe bağlı #çapa ile) veya https adresi; depo içi yollar denetlenir."},
        "zaman": {"type": "string", "format": "date-time"}
      }
    }
  }
}
